<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

{{> header}}


<div class="lesson-page">

    <a href="/lessons" class="back-link">
        ← Назад к урокам
    </a>


    <section class="lesson-header">

        <div class="lesson-number">
            УРОК 5
        </div>

        <h1>Зачем нужна физическая активность?</h1>

        <p class="lesson-intro">
            Движение помогает нам быть активными,
            меньше сидеть без движения и чувствовать себя бодрее.
        </p>

    </section>


    <section class="lesson-main">

        <div class="lesson-illustration">

            <div class="spine-placeholder">
                🏃
            </div>

            <div class="illustration-character">
                🐼
            </div>

        </div>


        <div class="lesson-text">

            <div class="text-icon">
                💚
            </div>

            <h2>Движение важно каждый день</h2>

            <p>
                Нашему организму важно регулярно двигаться.
                Физическая активность помогает делать день
                более разнообразным и активным.
            </p>

            <p>
                Если долго сидеть за компьютером или за столом,
                полезно делать небольшие активные паузы:
                встать, пройтись и немного подвигаться.
            </p>

            <p>
                Активность может быть разной:
                прогулка, игры, плавание, разминка или другой
                подходящий вид спорта.
            </p>

            <p>
                Не обязательно заниматься долго.
                Даже небольшие активные перерывы помогают
                сделать день более подвижным.
            </p>

            <p>
                Если во время активности появляется боль
                или становится плохо, нужно остановиться
                и рассказать об этом взрослому.
            </p>

        </div>

    </section>


    <section class="remember-card">

        <div class="remember-icon">
            💡
        </div>

        <div>

            <h2>Запомни</h2>

            <p>
                Регулярное движение помогает не проводить
                весь день сидя. Делай небольшие активные
                паузы и выбирай подходящие тебе виды активности.
            </p>

        </div>

    </section>


    <section class="lesson-quiz">

        <div class="quiz-label">
            🧠 ПРОВЕРИ СЕБЯ
        </div>

        <h2>
            Что полезно делать после долгого сидения?
        </h2>

        <p class="quiz-description">
            Выбери правильный вариант.
        </p>


        <div class="quiz-options">

            <button
                class="quiz-option"
                onclick="checkAnswer(this, true)">
                Сделать небольшую активную паузу и подвигаться
            </button>

            <button
                class="quiz-option"
                onclick="checkAnswer(this, false)">
                Продолжать сидеть без перерыва
            </button>

            <button
                class="quiz-option"
                onclick="checkAnswer(this, false)">
                Вообще не двигаться весь день
            </button>

        </div>


        <div id="quiz-result" class="quiz-result"></div>

    </section>


    <div class="lesson-navigation">

        <a href="/lessons/4" class="lesson-button secondary">
            ← Предыдущий
        </a>

        <a href="/lessons/6" class="lesson-button">
            Следующий урок →
        </a>

    </div>

</div>


<script>

    function checkAnswer(button, correct) {

        const result = document.getElementById('quiz-result');

        const buttons = document.querySelectorAll('.quiz-option');

        buttons.forEach(function(item) {
            item.disabled = true;
        });


        if (correct) {

            button.classList.add('correct');

            result.innerHTML =
                '🎉 Правильно! Отличная работа! ⭐ +10 XP';

            result.classList.add('success');

        } else {

            button.classList.add('wrong');

            result.innerHTML =
                '🙂 Не совсем. Правильный ответ — первый вариант.';

            result.classList.add('error');

            buttons.forEach(function(item) {

                if (item.textContent.includes(
                    'Сделать небольшую активную паузу'
                )) {
                    item.classList.add('correct');
                }

            });

        }

    }

</script>

<script src="/js/activity.js"></script>
<script>
    (function () {
        let savedThisPage = false;

        document.addEventListener('click', function (event) {
            const button = event.target.closest('.quiz-option');
            if (!button || savedThisPage) return;

            setTimeout(async function () {
                if (!button.classList.contains('correct')) return;
                if (!window.PostureTime) return;

                savedThisPage = true;

                try {
                    await window.PostureTime.saveLesson(5);
                } catch (error) {
                    savedThisPage = false;
                    console.log('Урок не сохранён:', error.message);
                }
            }, 0);
        });
    })();
</script>

</body>
</html>
