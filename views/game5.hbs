<!DOCTYPE html>
<html lang="ru">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Полезная реакция — Posture Time</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

<style>

body {
    background:linear-gradient(180deg,#eef8ff,#ffffff);
    color:#183b63;
}

.game-page {
    padding:35px 0 60px;
}

.game-header {
    text-align:center;
    margin-bottom:25px;
}

.game-header h1 {
    font-size:38px;
    font-weight:800;
    color:#183f72;
}

.game-header p {
    color:#71879c;
}

.game-panel {
    max-width:750px;
    margin:auto;
    padding:25px;
    background:white;
    border-radius:30px;
    box-shadow:0 15px 40px rgba(61,126,170,.12);
}

.stats {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.stat {
    padding:14px;
    background:#f3f8ff;
    border-radius:17px;
    text-align:center;
}

.stat span {
    display:block;
    color:#8497aa;
    font-size:12px;
}

.stat strong {
    font-size:22px;
}

.reaction {
    margin:25px 0;
    min-height:280px;
    border-radius:25px;
    background:#f4f9ff;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
}

.reaction-icon {
    font-size:100px;
    margin-bottom:15px;
}

.reaction-button {
    width:100%;
    min-height:100px;
    border:0;
    border-radius:22px;
    background:#dceeff;
    color:#2b659f;
    font-size:24px;
    font-weight:800;
    cursor:pointer;
}

.reaction-button.ready {
    background:#fff0a8;
}

.reaction-button.good {
    background:#bdf0d8;
}

.message {
    text-align:center;
    min-height:25px;
    margin:15px;
    font-weight:700;
    color:#617b92;
}

.buttons {
    display:flex;
    justify-content:center;
    gap:10px;
}

.button {
    border:0;
    padding:12px 20px;
    border-radius:15px;
    background:#27c995;
    color:white;
    font-weight:700;
    cursor:pointer;
}

.button.secondary {
    background:#e4f1ff;
    color:#2864a5;
}

</style>

</head>

<body>

{{> header}}

<main>

<div class="container game-page">

<div class="game-header">

<h1>⚡ Полезная реакция</h1>

<p>
Проверь, насколько быстро ты умеешь реагировать.
</p>

</div>

<div class="game-panel">

<div class="stats">

<div class="stat">
<span>Очки</span>
<strong id="score">0</strong>
</div>

<div class="stat">
<span>Серия</span>
<strong id="combo">0</strong>
</div>

<div class="stat">
<span>Раунд</span>
<strong id="round">0</strong>
</div>

</div>

<div class="reaction">

<div class="reaction-icon" id="icon">
⚡
</div>

<button
    class="reaction-button"
    id="reactionButton"
>
Нажми «Начать»
</button>

</div>

<div class="message" id="message">
Будь внимательна!
</div>

<div class="buttons">

<button class="button" id="start">
▶ Начать
</button>

<button class="button secondary" id="restart">
🔄 Заново
</button>

</div>

</div>

</div>

</main>

<script src="/js/character.js"></script>

<script>

const button =
    document.getElementById("reactionButton");

const message =
    document.getElementById("message");

const icon =
    document.getElementById("icon");

let score = 0;
let combo = 0;
let round = 0;
let playing = false;
let ready = false;
let timer;

function update() {

    document.getElementById("score").textContent = score;
    document.getElementById("combo").textContent = combo;
    document.getElementById("round").textContent = round;

}

function nextReaction() {

    if (!playing) return;

    ready = false;

    button.className = "reaction-button";
    button.textContent = "Жди...";

    icon.textContent = "👀";

    const delay =
        800 + Math.random() * 2200;

    timer = setTimeout(function() {

        ready = true;

        button.className =
            "reaction-button ready";

        button.textContent =
            "⚡ НАЖИМАЙ!";

        icon.textContent = "⚡";

    },delay);

}

button.addEventListener("click",function() {

    if (!playing) return;

    if (!ready) {

        score = Math.max(0,score - 5);
        combo = 0;

        message.textContent =
            "Слишком рано! 😄";

        update();

        clearTimeout(timer);

        setTimeout(nextReaction,500);

        return;
    }

    ready = false;

    score += 10 + combo * 2;
    combo++;
    round++;

    button.className =
        "reaction-button good";

    button.textContent =
        "Отличная реакция! ⭐";

    message.textContent =
        "Попадание! Серия: " + combo;

    update();

    setTimeout(nextReaction,600);

});

function startGame() {

    clearTimeout(timer);

    score = 0;
    combo = 0;
    round = 0;
    playing = true;

    update();

    message.textContent =
        "Жди сигнала...";

    nextReaction();
}

document.getElementById("start")
    .addEventListener("click",startGame);

document.getElementById("restart")
    .addEventListener("click",startGame);

</script>

<script>
(function () {
    let resultSaved = false;

    function saveRound() {
        if (resultSaved || !playing) return;
        resultSaved = true;

        if (window.PostureTime) {
            window.PostureTime.saveGame(5, score).catch(function () {});
        }
    }


    document.querySelectorAll('#start, #restart').forEach(function (button) {
        button.addEventListener('click', function () {
            resultSaved = false;
        });
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') saveRound();
    });

    window.addEventListener('pagehide', saveRound);
})();
</script>
<script src="/js/character.js"></script>
<script src="/js/game-music.js"></script>
</body>

</html>