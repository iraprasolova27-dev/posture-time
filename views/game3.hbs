<!DOCTYPE html>
<html lang="ru">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Рюкзак-марафон — Posture Time</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

<style>

body {
    background: linear-gradient(180deg,#eef8ff,#ffffff);
    color:#183b63;
}

.game-page {
    padding:35px 0 60px;
}

.game-header {
    text-align:center;
    margin-bottom:25px;
}

.game-header h1 {
    font-size:38px;
    font-weight:800;
    color:#183f72;
}

.game-header p {
    color:#71879c;
}

.game-panel {
    max-width:850px;
    margin:auto;
    background:white;
    padding:25px;
    border-radius:30px;
    box-shadow:0 15px 40px rgba(61,126,170,.12);
}

.stats {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-bottom:20px;
}

.stat {
    padding:14px;
    text-align:center;
    background:#f3f8ff;
    border-radius:17px;
}

.stat span {
    display:block;
    font-size:12px;
    color:#8497aa;
}

.stat strong {
    font-size:22px;
}

.backpack {
    width:260px;
    height:300px;
    margin:10px auto 25px;
    border-radius:80px 80px 45px 45px;
    background:linear-gradient(135deg,#a7d6ff,#6ca9e8);
    border:8px solid #538fcf;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:110px;
}

.items {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.item {
    border:2px solid #dfebf7;
    background:white;
    border-radius:18px;
    padding:20px 10px;
    cursor:pointer;
    font-size:40px;
    text-align:center;
}

.item:hover {
    transform:translateY(-3px);
    border-color:#83c9aa;
}

.item.good {
    background:#e2f8ed;
    border-color:#4fc995;
}

.item.bad {
    background:#fff0f0;
    border-color:#ed9090;
}

.item span {
    display:block;
    margin-top:5px;
    font-size:12px;
    font-weight:700;
    color:#698197;
}

.message {
    min-height:28px;
    text-align:center;
    margin:20px 0;
    font-weight:700;
    color:#617b92;
}

.buttons {
    display:flex;
    justify-content:center;
    gap:10px;
}

.button {
    border:0;
    padding:12px 20px;
    border-radius:15px;
    font-weight:700;
    background:#27c995;
    color:white;
    cursor:pointer;
}

.button.secondary {
    background:#e4f1ff;
    color:#2864a5;
}

@media(max-width:650px) {
    .items {
        grid-template-columns:repeat(2,1fr);
    }

    .backpack {
        width:200px;
        height:230px;
        font-size:80px;
    }
}

</style>

</head>

<body>

{{> header}}

<main>

<div class="container game-page">

<div class="game-header">

<h1>🎒 Рюкзак-марафон</h1>

<p>
Собери полезный рюкзак и не добавляй туда лишнее.
</p>

</div>

<div class="game-panel">

<div class="stats">

<div class="stat">
<span>Очки</span>
<strong id="score">0</strong>
</div>

<div class="stat">
<span>Раунд</span>
<strong id="round">1</strong>
</div>

<div class="stat">
<span>Предметов</span>
<strong id="count">0</strong>
</div>

</div>

<div class="backpack">
🎒
</div>

<div class="items" id="items"></div>

<div class="message" id="message">
Нажми на полезные вещи!
</div>

<div class="buttons">

<button class="button" id="start">
▶ Начать
</button>

<button class="button secondary" id="restart">
🔄 Заново
</button>

</div>

</div>

</div>

</main>

<script src="/js/character.js"></script>

<script>

const allItems = [

["📚","Учебник",true],
["✏️","Карандаш",true],
["🖊️","Ручка",true],
["💧","Вода",true],
["📓","Тетрадь",true],
["🍎","Перекус",true],

["🧸","Игрушка",false],
["🪨","Камень",false],
["🎮","Тяжёлая приставка",false],
["🛹","Скейт",false],
["🔩","Металл",false],
["🍫","Лишняя еда",false]

];

let score = 0;
let round = 1;
let count = 0;
let playing = false;

const itemsContainer =
    document.getElementById("items");

const message =
    document.getElementById("message");

function shuffle(array) {
    return [...array].sort(() => Math.random() - .5);
}

function createRound() {

    itemsContainer.innerHTML = "";

    const selected =
        shuffle(allItems).slice(0,8);

    selected.forEach(([emoji,name,good]) => {

        const button =
            document.createElement("button");

        button.className = "item";

        button.innerHTML =
            emoji + "<span>" + name + "</span>";

        button.addEventListener("click",function() {

            if (!playing || button.disabled) return;

            button.disabled = true;

            if (good) {

                button.classList.add("good");

                score += 10;
                count++;

                message.textContent =
                    "Отличный выбор! 🎒";

            } else {

                button.classList.add("bad");

                score = Math.max(0,score - 5);

                message.textContent =
                    "Это лучше оставить дома 🙂";
            }

            update();

        });

        itemsContainer.appendChild(button);
    });

}

function update() {

    document.getElementById("score").textContent = score;
    document.getElementById("round").textContent = round;
    document.getElementById("count").textContent = count;

}

function startGame() {

    score = 0;
    round = 1;
    count = 0;
    playing = true;

    update();
    createRound();

    message.textContent =
        "Собери рюкзак!";
}

function nextRound() {

    if (!playing) return;

    round++;

    createRound();

    message.textContent =
        "Новый раунд! 🎒";
}

document.getElementById("start")
    .addEventListener("click",startGame);

document.getElementById("restart")
    .addEventListener("click",startGame);

setInterval(function() {

    if (playing) {
        nextRound();
    }

},10000);

createRound();

</script>

<script>
(function () {
    let resultSaved = false;

    function saveRound() {
        if (resultSaved || !playing) return;
        resultSaved = true;

        if (window.PostureTime) {
            window.PostureTime.saveGame(3, score).catch(function () {});
        }
    }


    document.querySelectorAll('#start, #restart').forEach(function (button) {
        button.addEventListener('click', function () {
            resultSaved = false;
        });
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') saveRound();
    });

    window.addEventListener('pagehide', saveRound);
})();
</script>
<script src="/js/character.js"></script>
<script src="/js/game-music.js"></script>
</body>
</html>