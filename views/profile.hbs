<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Профиль — Posture Time</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/characters.css">

    <style>
        .profile-page {
            padding: 40px 0 60px;
        }

        .profile-card {
            background: white;
            border-radius: 28px;
            padding: 35px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(60, 70, 100, 0.08);
            margin-bottom: 25px;
        }

        .avatar {
            width: 120px;
            height: 120px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: linear-gradient(135deg, #dff7ff, #e9ddff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 65px;
        }

        .profile-name {
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .profile-level {
            color: #68758a;
            margin-bottom: 25px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .stat {
            background: #f7f8fc;
            border-radius: 20px;
            padding: 22px;
        }

        .stat-icon {
            font-size: 32px;
        }

        .stat-number {
            font-size: 27px;
            font-weight: bold;
            color: #5d6eea;
            margin-top: 7px;
        }

        .stat-name {
            color: #748096;
            margin-top: 5px;
        }

        .profile-section {
            background: white;
            border-radius: 25px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 8px 25px rgba(60, 70, 100, 0.08);
        }

        .profile-section h2 {
            margin-top: 0;
            margin-bottom: 12px;
        }

        .profile-info-text {
            color: #68758a;
            line-height: 1.6;
        }

        /* Данные профиля */

        .profile-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-top: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: bold;
            margin-bottom: 8px;
            color: #374151;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 15px;
            border: 2px solid #e7e9f0;
            border-radius: 14px;
            font-size: 16px;
            outline: none;
            background: white;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #5d6eea;
        }

        .save-button {
            border: none;
            background: #5d6eea;
            color: white;
            padding: 14px 24px;
            border-radius: 14px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
        }

        .save-button:hover {
            background: #4d5dd2;
        }

        .save-message {
            display: none;
            margin-top: 15px;
            padding: 12px 15px;
            border-radius: 12px;
            background: #e9f9ef;
            color: #24733d;
            font-weight: bold;
        }

        /* Персонажи */

        .character-list {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .character-choice {
            width: 85px;
            height: 85px;
            border: 2px solid transparent;
            border-radius: 20px;
            background: #f5f6fa;
            font-size: 42px;
            cursor: pointer;
        }

        .character-choice:hover {
            background: #eef0ff;
        }

        .character-choice.selected {
            border-color: #5d6eea;
            background: #eef0ff;
        }

        /* Кнопки профиля */

        .profile-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 5px;
        }

        .profile-button {
            display: inline-block;
            text-decoration: none;
            background: #5d6eea;
            color: white;
            padding: 13px 22px;
            border-radius: 14px;
            font-weight: bold;
        }

        .profile-button:hover {
            background: #4d5dd2;
            color: white;
        }

        .logout-button {
            display: inline-block;
            text-decoration: none;
            background: #fff1f1;
            color: #d94b4b;
            border: 2px solid #ffd6d6;
            padding: 11px 20px;
            border-radius: 14px;
            font-weight: bold;
        }

        .logout-button:hover {
            background: #ffe4e4;
            color: #c43d3d;
        }

        @media (max-width: 800px) {

            .stats {
                grid-template-columns: 1fr;
            }

            .profile-form {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .profile-actions {
                flex-direction: column;
            }

            .profile-button,
            .logout-button {
                text-align: center;
            }
        }
    </style>
</head>


<body>

{{> header}}


<main class="profile-page">

    <div class="container">


        <!-- ГЛАВНАЯ КАРТОЧКА ПРОФИЛЯ -->

        <div class="profile-card">

            <div
                class="avatar character main-character"
                id="mainAvatar">
                🦊
            </div>


            <div
                class="profile-name"
                id="profileName">
                Пользователь
            </div>


            <div class="profile-level">

                🌟 Уровень
                <span id="level">
                    1
                </span>

            </div>


            <div class="stats">


                <div class="stat">

                    <div class="stat-icon">
                        ⭐
                    </div>

                    <div
                        class="stat-number"
                        id="xp">
                        0
                    </div>

                    <div class="stat-name">
                        XP
                    </div>

                </div>


                <div class="stat">

                    <div class="stat-icon">
                        🏃
                    </div>

                    <div
                        class="stat-number"
                        id="workouts">
                        0
                    </div>

                    <div class="stat-name">
                        Активностей
                    </div>

                </div>


                <div class="stat">

                    <div class="stat-icon">
                        🏆
                    </div>

                    <div
                        class="stat-number"
                        id="achievements">
                        0
                    </div>

                    <div class="stat-name">
                        Достижений
                    </div>

                </div>


            </div>

        </div>



        <!-- ДАННЫЕ ПОЛЬЗОВАТЕЛЯ -->

        <div class="profile-section">

            <h2>
                👤 Мои данные
            </h2>

            <p class="profile-info-text">
                Заполни информацию о себе. Эти данные сохраняются в твоём аккаунте и доступны после входа.
            </p>


            <form
                class="profile-form"
                id="profileForm">


                <div class="form-group">

                    <label for="userName">
                        Имя
                    </label>

                    <input
                        type="text"
                        id="userName"
                        value="{{user.name}}"
                        placeholder="Например, Лиля"
                        maxlength="30"
                        required>

                </div>


                <div class="form-group">

                    <label for="userAge">
                        Возраст
                    </label>

                    <input
                        type="number"
                        id="userAge"
                        value="{{user.age}}"
                        placeholder="Например, 12"
                        min="1"
                        max="100"
                        required>

                </div>


                <div class="form-group">

                    <label for="userHeight">
                        Рост, см
                    </label>

                    <input
                        type="number"
                        id="userHeight"
                        value="{{user.height_cm}}"
                        placeholder="Например, 150"
                        min="50"
                        max="250">

                </div>


                <div class="form-group">

                    <label for="userActivity">
                        Любимая активность
                    </label>

                    <select id="userActivity" data-current-value="{{user.favorite_activity}}">

                        <option value="">
                            Выбери активность
                        </option>

                        <option value="Прогулки">
                            🚶 Прогулки
                        </option>

                        <option value="Плавание">
                            🏊 Плавание
                        </option>

                        <option value="Велосипед">
                            🚲 Велосипед
                        </option>

                        <option value="Танцы">
                            💃 Танцы
                        </option>

                        <option value="Футбол">
                            ⚽ Футбол
                        </option>

                        <option value="Баскетбол">
                            🏀 Баскетбол
                        </option>

                        <option value="Зарядка">
                            🤸 Зарядка
                        </option>

                        <option value="Другое">
                            ⭐ Другое
                        </option>

                    </select>

                </div>


                <div class="form-group full">

                    <label for="userAbout">
                        Немного о себе
                    </label>

                    <input
                        type="text"
                        id="userAbout"
                        value="{{user.about}}"
                        placeholder="Например: люблю гулять и играть в футбол"
                        maxlength="150">

                </div>


                <div class="form-group full">

                    <button
                        type="submit"
                        class="save-button">
                        💾 Сохранить профиль
                    </button>

                </div>

            </form>


            <div
                class="save-message"
                id="saveMessage">
                ✅ Профиль сохранён!
            </div>

        </div>



        <!-- ВЫБОР ПЕРСОНАЖА -->

        <div class="profile-section">

            <h2>
                🧸 Мой персонаж
            </h2>

            <p class="profile-info-text">
                Выбери персонажа, который будет сопровождать тебя
                в Posture Time.
            </p>


            <div class="character-list">


                <button
                    type="button"
                    class="character-choice selected"
                    data-avatar="🦊">
                    🦊
                </button>


                <button
                    type="button"
                    class="character-choice"
                    data-avatar="🐼">
                    🐼
                </button>


                <button
                    type="button"
                    class="character-choice"
                    data-avatar="🐱">
                    🐱
                </button>


                <button
                    type="button"
                    class="character-choice"
                    data-avatar="🐻">
                    🐻
                </button>


                <button
                    type="button"
                    class="character-choice"
                    data-avatar="🤖">
                    🤖
                </button>


                <button
                    type="button"
                    class="character-choice"
                    data-avatar="🐰">
                    🐰
                </button>


            </div>

        </div>



        <!-- ИНФОРМАЦИЯ -->

        <div class="profile-section">

            <h2>
                💡 О профиле
            </h2>

            <p class="profile-info-text">
                Здесь отображаются твои данные, персонаж,
                уровень, XP, активности и достижения.
            </p>

            <p class="profile-info-text">
                Данные профиля и прогресс сохраняются в твоём аккаунте.
            </p>

        </div>


        <!-- КНОПКИ ПРОФИЛЯ -->

        <div class="profile-actions">

            <a
                href="/settings"
                class="profile-button">
                ⚙️ Настройки
            </a>

            <a
                href="/logout"
                class="logout-button">
                🚪 Выйти из аккаунта
            </a>

        </div>


    </div>

</main>






<script src="/js/character.js"></script>


<script>
    const profileForm = document.getElementById('profileForm');
    const saveMessage = document.getElementById('saveMessage');

    const favoriteActivity = document.getElementById('userActivity');
    if (favoriteActivity) {
        favoriteActivity.value = favoriteActivity.dataset.currentValue || '';
    }

    profileForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const button = profileForm.querySelector('.save-button');
        button.disabled = true;

        try {
            const response = await fetch('/api/profile', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    name: document.getElementById('userName').value,
                    age: document.getElementById('userAge').value,
                    height: document.getElementById('userHeight').value,
                    favoriteActivity: document.getElementById('userActivity').value,
                    about: document.getElementById('userAbout').value,
                    avatar: localStorage.getItem('postureTimeAvatar') || '🦊'
                })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || 'Не удалось сохранить профиль.');
            }

            document.getElementById('profileName').textContent = data.user.name;

            saveMessage.textContent = '✅ Профиль сохранён!';
            saveMessage.style.display = 'block';

            setTimeout(function () {
                saveMessage.style.display = 'none';
            }, 2500);

            if (window.PostureTime) {
                window.PostureTime.refreshStats();
            }
        } catch (error) {
            saveMessage.textContent = '❌ ' + error.message;
            saveMessage.style.display = 'block';
        } finally {
            button.disabled = false;
        }
    });

    document.addEventListener('posturetime:stats', function (event) {
        const stats = event.detail;
        if (!stats || !stats.authenticated) return;

        document.getElementById('xp').textContent = stats.xp;
        document.getElementById('workouts').textContent = stats.totalActivities;
        document.getElementById('achievements').textContent = stats.achievements;
        document.getElementById('level').textContent = stats.level;
    });
</script>

</body>
</html>