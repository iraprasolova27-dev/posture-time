<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

{{> header}}


<div class="lesson-page">

    <a href="/lessons" class="back-link">
        ← Назад к урокам
    </a>


    <section class="lesson-header">

        <div class="lesson-number">
            УРОК 4
        </div>

        <h1>Что такое кифоз?</h1>

        <p class="lesson-intro">
            Кифоз связан с изгибом позвоночника назад
            в грудном отделе.
        </p>

    </section>


    <section class="lesson-main">

        <div class="lesson-illustration">

            <div class="spine-placeholder">
                🦴
            </div>

            <div class="illustration-character">
                🐻
            </div>

        </div>


        <div class="lesson-text">

            <div class="text-icon">
                💙
            </div>

            <h2>Позвоночник имеет изгибы</h2>

            <p>
                Если посмотреть на позвоночник сбоку,
                можно увидеть несколько естественных изгибов.
            </p>

            <p>
                Один из них находится в грудном отделе
                и называется грудным кифозом.
            </p>

            <p>
                Небольшой естественный изгиб является
                нормальной частью строения позвоночника.
            </p>

            <p>
                Если у человека возникают вопросы или
                неприятные ощущения в спине, важно рассказать
                об этом взрослому и обратиться к специалисту.
            </p>

        </div>

    </section>


    <section class="remember-card">

        <div class="remember-icon">
            💡
        </div>

        <div>

            <h2>Запомни</h2>

            <p>
                Кифоз — это изгиб позвоночника назад
                в грудном отделе. Небольшой естественный
                грудной кифоз является частью нормального
                строения позвоночника.
            </p>

        </div>

    </section>


    <section class="lesson-quiz">

        <div class="quiz-label">
            🧠 ПРОВЕРИ СЕБЯ
        </div>

        <h2>
            Где находится грудной кифоз?
        </h2>

        <p class="quiz-description">
            Выбери правильный вариант.
        </p>


<div class="quiz-options">

    <button
        class="quiz-option"
        onclick="checkAnswer(this, true)">
        В грудном отделе позвоночника
    </button>

    <button
        class="quiz-option"
        onclick="checkAnswer(this, false)">
        Только в шее
    </button>

    <button
        class="quiz-option"
        onclick="checkAnswer(this, false)">
        Только в ногах
    </button>

</div>


        <div id="quiz-result" class="quiz-result"></div>

    </section>


    <div class="lesson-navigation">

        <a href="/lessons/3" class="lesson-button secondary">
            ← Предыдущий
        </a>

        <a href="/lessons/5" class="lesson-button">
            Следующий урок →
        </a>

    </div>

</div>


<script>

    function checkAnswer(button, correct) {

        const result = document.getElementById('quiz-result');

        const buttons = document.querySelectorAll('.quiz-option');

        buttons.forEach(function(item) {
            item.disabled = true;
        });


        if (correct) {

            button.classList.add('correct');

            result.innerHTML =
                '🎉 Правильно! Отличная работа! ⭐ +10 XP';

            result.classList.add('success');

        } else {

            button.classList.add('wrong');

            result.innerHTML =
    '🙂 Не совсем. Правильный ответ — первый вариант.';
            result.classList.add('error');

            buttons.forEach(function(item) {

              if (item.textContent.includes('В грудном отделе позвоночника')) {
    item.classList.add('correct');
}

            });

        }

    }

</script>

<script src="/js/activity.js"></script>
<script>
    (function () {
        let savedThisPage = false;

        document.addEventListener('click', function (event) {
            const button = event.target.closest('.quiz-option');
            if (!button || savedThisPage) return;

            setTimeout(async function () {
                if (!button.classList.contains('correct')) return;
                if (!window.PostureTime) return;

                savedThisPage = true;

                try {
                    await window.PostureTime.saveLesson(4);
                } catch (error) {
                    savedThisPage = false;
                    console.log('Урок не сохранён:', error.message);
                }
            }, 0);
        });
    })();
</script>

</body>
</html>
