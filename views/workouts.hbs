<!DOCTYPE html>
<html lang="ru">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>{{title}}</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Основные стили -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- Стили персонажей -->
    <link
        rel="stylesheet"
        href="/css/characters.css"
    >

    <style>

        /* =========================
           СТРАНИЦА ТРЕНИРОВОК
        ========================== */

        .workouts-page {
            padding: 45px 0 60px;
        }


        /* =========================
           ЗАГОЛОВОК
        ========================== */

        .workouts-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 40px;
        }

        .workouts-heading-text {
            max-width: 650px;
        }

        .workouts-label {
            display: inline-block;
            margin-bottom: 10px;
            padding: 7px 14px;
            border-radius: 20px;
            background: #e8f8f1;
            color: #26966d;
            font-size: 14px;
            font-weight: 700;
        }

        .workouts-heading h1 {
            margin: 0 0 12px;
            font-size: 42px;
            font-weight: 800;
        }

        .workouts-heading p {
            margin: 0;
            color: #6b7280;
            font-size: 17px;
            line-height: 1.6;
        }

        .workouts-character {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 110px;
            height: 110px;
            flex-shrink: 0;
            border-radius: 35px;
            background: linear-gradient(
                135deg,
                #e8f8ff,
                #e9f8ef
            );
            font-size: 62px;
            box-shadow: 0 15px 35px rgba(40, 80, 130, 0.12);
        }


        /* =========================
           ВИДЕО
        ========================== */

        .workouts-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .video-workout-card {
            overflow: hidden;
            background: white;
            border-radius: 28px;
            box-shadow: 0 12px 35px rgba(40, 80, 130, 0.10);
            border: 1px solid rgba(80, 120, 160, 0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .video-workout-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 42px rgba(40, 80, 130, 0.15);
        }

        .video-wrapper {
            position: relative;
            width: 100%;
            background: #eef5f8;
            aspect-ratio: 16 / 9;
        }

        .video-wrapper video {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #eef5f8;
        }

        .video-card-body {
            padding: 22px;
        }

        .video-card-number {
            display: inline-block;
            margin-bottom: 10px;
            padding: 6px 12px;
            border-radius: 14px;
            background: #f0f7ff;
            color: #4d7ec4;
            font-size: 13px;
            font-weight: 700;
        }

        .video-card-body h2 {
            margin: 0 0 18px;
            font-size: 24px;
            font-weight: 800;
        }

        .watch-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 48px;
            padding: 12px 20px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(
                135deg,
                #63cfa5,
                #4db7d7
            );
            color: white;
            text-decoration: none;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .watch-button:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(70, 180, 170, 0.25);
        }


        /* =========================
           ПОДСКАЗКА
        ========================== */

        .workouts-tip {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 35px;
            padding: 20px 24px;
            border-radius: 22px;
            background: linear-gradient(
                135deg,
                #f2fbff,
                #f1fbf5
            );
        }

        .workouts-tip-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            border-radius: 16px;
            background: white;
            font-size: 25px;
        }

        .workouts-tip strong {
            display: block;
            margin-bottom: 4px;
            font-size: 16px;
        }

        .workouts-tip p {
            margin: 0;
            color: #667085;
            font-size: 14px;
            line-height: 1.5;
        }


        /* =========================
           АДАПТИВ
        ========================== */

        @media (max-width: 1000px) {

            .workouts-grid {
                grid-template-columns: repeat(2, 1fr);
            }

        }


        @media (max-width: 700px) {

            .workouts-page {
                padding: 30px 0 45px;
            }

            .workouts-heading {
                align-items: flex-start;
            }

            .workouts-heading h1 {
                font-size: 32px;
            }

            .workouts-character {
                width: 80px;
                height: 80px;
                border-radius: 25px;
                font-size: 45px;
            }

            .workouts-grid {
                grid-template-columns: 1fr;
            }

        }


        @media (max-width: 480px) {

            .workouts-heading {
                flex-direction: column;
            }

            .workouts-character {
                width: 75px;
                height: 75px;
            }

        }

    </style>

</head>


<body>


    <!-- =========================
         ШАПКА
    ========================== -->

    {{> header}}


    <!-- =========================
         ОСНОВНОЕ СОДЕРЖИМОЕ
    ========================== -->

    <main>

        <div class="container workouts-page">


            <!-- =========================
                 ЗАГОЛОВОК
            ========================== -->

            <section class="workouts-heading">

                <div class="workouts-heading-text">

                    <span class="workouts-label">
                        🏃 Время двигаться
                    </span>

                    <h1>
                        Тренировки
                    </h1>

                    <p>
                        Выбери любую тренировку и просто
                        повторяй движения за видео.
                    </p>

                </div>


                <!-- ПЕРСОНАЖ -->

                <div class="workouts-character character">
                    🦊
                </div>

            </section>


            <!-- =========================
                 4 ВИДЕО
            ========================== -->

            <section class="workouts-grid">


                <!-- =====================
                     ТРЕНИРОВКА 1
                ====================== -->

                <article class="video-workout-card">

                    <div class="video-wrapper">

                        <video
                            controls
                            preload="metadata"
                            playsinline
                            data-workout-id="1"
                        >
                            <source
                                src="/videos/workout1.mp4"
                                type="video/mp4"
                            >

                            Твой браузер не поддерживает
                            просмотр видео.
                        </video>

                    </div>

                    <div class="video-card-body">

                        <span class="video-card-number">
                            🏃 Тренировка 1
                        </span>

                        <h2>
                            Тренировка 1
                        </h2>

                        <button
                            type="button"
                            class="watch-button"
                            onclick="playVideo(this)"
                        >
                            ▶ Смотреть
                        </button>

                    </div>

                </article>


                <!-- =====================
                     ТРЕНИРОВКА 2
                ====================== -->

                <article class="video-workout-card">

                    <div class="video-wrapper">

                        <video
                            controls
                            preload="metadata"
                            playsinline
                            data-workout-id="2"
                        >
                            <source
                                src="/videos/workout2.mp4"
                                type="video/mp4"
                            >

                            Твой браузер не поддерживает
                            просмотр видео.
                        </video>

                    </div>

                    <div class="video-card-body">

                        <span class="video-card-number">
                            ⭐ Тренировка 2
                        </span>

                        <h2>
                            Тренировка 2
                        </h2>

                        <button
                            type="button"
                            class="watch-button"
                            onclick="playVideo(this)"
                        >
                            ▶ Смотреть
                        </button>

                    </div>

                </article>


                <!-- =====================
                     ТРЕНИРОВКА 3
                ====================== -->

                <article class="video-workout-card">

                    <div class="video-wrapper">

                        <video
                            controls
                            preload="metadata"
                            playsinline
                            data-workout-id="3"
                        >
                            <source
                                src="/videos/workout3.mp4"
                                type="video/mp4"
                            >

                            Твой браузер не поддерживает
                            просмотр видео.
                        </video>

                    </div>

                    <div class="video-card-body">

                        <span class="video-card-number">
                            💚 Тренировка 3
                        </span>

                        <h2>
                            Тренировка 3
                        </h2>

                        <button
                            type="button"
                            class="watch-button"
                            onclick="playVideo(this)"
                        >
                            ▶ Смотреть
                        </button>

                    </div>

                </article>


                <!-- =====================
                     ТРЕНИРОВКА 4
                ====================== -->

                <article class="video-workout-card">

                    <div class="video-wrapper">

                        <video
                            controls
                            preload="metadata"
                            playsinline
                            data-workout-id="4"
                        >
                            <source
                                src="/videos/workout4.mp4"
                                type="video/mp4"
                            >

                            Твой браузер не поддерживает
                            просмотр видео.
                        </video>

                    </div>

                    <div class="video-card-body">

                        <span class="video-card-number">
                            🌟 Тренировка 4
                        </span>

                        <h2>
                            Тренировка 4
                        </h2>

                        <button
                            type="button"
                            class="watch-button"
                            onclick="playVideo(this)"
                        >
                            ▶ Смотреть
                        </button>

                    </div>

                </article>


            </section>


            <!-- =========================
                 БЕЗОПАСНОСТЬ
            ========================== -->

            <section class="workouts-tip">

                <div class="workouts-tip-icon">
                    💙
                </div>

                <div>

                    <strong>
                        Помни о себе
                    </strong>

                    <p>
                        Если во время занятия тебе стало
                        больно или плохо — остановись
                        и скажи взрослому.
                    </p>

                </div>

            </section>


        </div>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-inner">

                <strong>
                    Posture Time
                </strong>

                <span>
                    Двигайся. Узнавай. Расти.
                </span>

                <span>
                    ❤️ Забота о себе — это круто!
                </span>

            </div>

        </div>

    </footer>


    <!-- =========================
         СКРИПТ ПЕРСОНАЖА
    ========================== -->

    <script src="/js/character.js"></script>


    <!-- =========================
         ОТКРЫТЬ ВИДЕО
    ========================== -->

    <script>

    function playVideo(button) {
        const card = button.closest('.video-workout-card');
        const video = card ? card.querySelector('video') : null;

        if (!video) return;

        video.play().catch(() => {});
    }

    document.querySelectorAll('.video-wrapper video').forEach(video => {
        video.addEventListener('ended', async function () {
            const workoutId = Number(video.dataset.workoutId);

            if (!workoutId || !window.PostureTime) return;

            try {
                const data = await window.PostureTime.saveWorkout(
                    workoutId,
                    video.duration || 0
                );

                if (data && data.xpEarned) {
                    // Данные уже обновлены через общий stats-событие.
                }
            } catch (error) {
                // Если пользователь не вошёл, видео всё равно можно смотреть.
                console.log('Тренировка не сохранена:', error.message);
            }
        });
    });

</script>

</body>

</html>