<!DOCTYPE html>
<html lang="ru">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Собери рабочее место — Posture Time</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

<style>

body {
    background:linear-gradient(180deg,#eef8ff,#ffffff);
    color:#183b63;
}

.game-page {
    padding:35px 0 60px;
}

.game-header {
    text-align:center;
    margin-bottom:25px;
}

.game-header h1 {
    font-size:38px;
    font-weight:800;
    color:#183f72;
}

.game-header p {
    color:#71879c;
}

.game-panel {
    max-width:900px;
    margin:auto;
    background:white;
    padding:25px;
    border-radius:30px;
    box-shadow:0 15px 40px rgba(61,126,170,.12);
}

.stats {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
    margin-bottom:20px;
}

.stat {
    text-align:center;
    padding:14px;
    background:#f3f8ff;
    border-radius:17px;
}

.stat span {
    display:block;
    color:#8497aa;
    font-size:12px;
}

.stat strong {
    font-size:22px;
}

.workspace {
    min-height:330px;
    position:relative;
    border-radius:25px;
    background:#f3f8ff;
    border:3px dashed #cfe2f3;
    margin-bottom:20px;
}

.zone {
    position:absolute;
    border:2px dashed #8db6d9;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:#7190aa;
    font-weight:700;
}

.screen-zone {
    left:20%;
    top:20px;
    width:60%;
    height:130px;
}

.chair-zone {
    left:25%;
    bottom:20px;
    width:50%;
    height:100px;
}

.items {
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:12px;
}

.item {
    border:2px solid #dfebf7;
    background:white;
    border-radius:18px;
    padding:15px 20px;
    cursor:pointer;
    font-size:30px;
}

.item.selected {
    border-color:#43c691;
    background:#e4f9ef;
}

.message {
    min-height:25px;
    text-align:center;
    margin:20px 0;
    font-weight:700;
    color:#607a91;
}

.buttons {
    display:flex;
    justify-content:center;
    gap:10px;
}

.button {
    border:0;
    padding:12px 20px;
    border-radius:15px;
    font-weight:700;
    background:#27c995;
    color:white;
    cursor:pointer;
}

.button.secondary {
    background:#e4f1ff;
    color:#2864a5;
}

</style>

</head>

<body>

{{> header}}

<main>

<div class="container game-page">

<div class="game-header">

<h1>🧩 Собери рабочее место</h1>

<p>
Расставляй предметы так, чтобы рабочее место было удобным.
</p>

</div>

<div class="game-panel">

<div class="stats">

<div class="stat">
<span>Очки</span>
<strong id="score">0</strong>
</div>

<div class="stat">
<span>Раунд</span>
<strong id="round">1</strong>
</div>

<div class="stat">
<span>Правильно</span>
<strong id="correct">0</strong>
</div>

</div>

<div class="workspace">

<div class="zone screen-zone">
🖥️ Экран
</div>

<div class="zone chair-zone">
🪑 Место для сидения
</div>

</div>

<div class="items" id="items"></div>

<div class="message" id="message">
Выбери предмет, который подходит для рабочего места.
</div>

<div class="buttons">

<button class="button" id="start">
▶ Начать
</button>

<button class="button secondary" id="restart">
🔄 Заново
</button>

</div>

</div>

</div>

</main>

<script src="/js/character.js"></script>

<script>

const itemList = [

["🖥️","Экран",true],
["⌨️","Клавиатура",true],
["🖱️","Мышь",true],
["💡","Лампа",true],
["📚","Книга",true],
["🪑","Стул",true],

["🍳","Сковорода",false],
["🛏️","Кровать",false],
["🛒","Тележка",false],
["🛁","Ванна",false]

];

let score = 0;
let round = 1;
let correct = 0;
let playing = false;

const container =
    document.getElementById("items");

const message =
    document.getElementById("message");

function shuffle(array) {
    return [...array].sort(() => Math.random() - .5);
}

function createRound() {

    container.innerHTML = "";

    shuffle(itemList)
        .slice(0,6)
        .forEach(([emoji,name,isCorrect]) => {

            const button =
                document.createElement("button");

            button.className = "item";

            button.textContent = emoji;

            button.title = name;

            button.addEventListener("click",function() {

                if (!playing || button.disabled) return;

                button.disabled = true;

                if (isCorrect) {

                    button.classList.add("selected");

                    score += 10;
                    correct++;

                    message.textContent =
                        name + " подходит! ⭐";

                } else {

                    message.textContent =
                        name + " лучше здесь не использовать 🙂";

                    score = Math.max(0,score - 5);
                }

                update();

            });

            container.appendChild(button);

        });

}

function update() {

    document.getElementById("score").textContent = score;
    document.getElementById("round").textContent = round;
    document.getElementById("correct").textContent = correct;

}

function startGame() {

    score = 0;
    round = 1;
    correct = 0;
    playing = true;

    update();
    createRound();

    message.textContent =
        "Собираем удобное рабочее место!";
}

function nextRound() {

    if (!playing) return;

    round++;

    createRound();

    message.textContent =
        "Новый вариант рабочего места!";
}

document.getElementById("start")
    .addEventListener("click",startGame);

document.getElementById("restart")
    .addEventListener("click",startGame);

setInterval(function() {

    if (playing) {
        nextRound();
    }

},9000);

createRound();

</script>

<script>
(function () {
    let resultSaved = false;

    function saveRound() {
        if (resultSaved || !playing) return;
        resultSaved = true;

        if (window.PostureTime) {
            window.PostureTime.saveGame(4, score).catch(function () {});
        }
    }


    document.querySelectorAll('#start, #restart').forEach(function (button) {
        button.addEventListener('click', function () {
            resultSaved = false;
        });
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') saveRound();
    });

    window.addEventListener('pagehide', saveRound);
})();
</script>
<script src="/js/character.js"></script>
<script src="/js/game-music.js"></script>
</body>

</html>