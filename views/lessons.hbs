<!DOCTYPE html>
<html lang="ru">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>{{title}}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

    <!-- =========================
         ШАПКА
    ========================== -->

    {{> header}}


    <!-- =========================
         ОСНОВНОЙ КОНТЕНТ
    ========================== -->

    <main>

        <div class="container lessons-page">


            <!-- ЗАГОЛОВОК -->

            <section class="lessons-heading">

                <span class="section-label">
                    📚 Узнавай новое
                </span>

                <h1>
                    Учимся заботиться о себе
                </h1>

                <p>
                    Небольшие уроки помогут узнать больше
                    о позвоночнике, осанке, движении
                    и полезных привычках.
                </p>

            </section>


            <!-- ВАЖНОЕ СООБЩЕНИЕ -->

            <div class="learning-note">

                <div class="learning-note-icon">
                    💡
                </div>

                <div>

                    <strong>
                        Знания + движение = хорошая привычка
                    </strong>

                    <p>
                        Изучай темы в удобном порядке
                        и попробуй применить знания
                        в обычной жизни.
                    </p>

                </div>

            </div>


            <!-- =========================
                 КАРТОЧКИ УРОКОВ
            ========================== -->

            <section class="lessons-grid">


                <!-- 1 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-blue">
                        🦴
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 1
                        </span>

                        <h2>
                            Что такое позвоночник?
                        </h2>

                        <p>
                            Узнай, из чего состоит позвоночник
                            и зачем он нужен человеку.
                        </p>

                        <a
                            href="/lessons/1"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 2 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-purple">
                        🧍
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 2
                        </span>

                        <h2>
                            Почему позвоночник не прямой?
                        </h2>

                        <p>
                            Разберёмся, какие изгибы есть
                            у здорового позвоночника.
                        </p>

                        <a
                            href="/lessons/2"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 3 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-green">
                        🪑
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 3
                        </span>

                        <h2>
                            Что такое осанка?
                        </h2>

                        <p>
                            Узнай, что такое осанка
                            и почему важно менять положение тела.
                        </p>

                        <a
                            href="/lessons/3"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 4 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-orange">
                        📖
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 4
                        </span>

                        <h2>
                            Что такое кифоз?
                        </h2>

                        <p>
                            Простыми словами узнаем
                            об естественных изгибах позвоночника.
                        </p>

                        <a
                            href="/lessons/4"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 5 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-pink">
                        🏃
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 5
                        </span>

                        <h2>
                            Зачем нужна физическая активность?
                        </h2>

                        <p>
                            Узнай, почему движение важно
                            в течение обычного дня.
                        </p>

                        <a
                            href="/lessons/5"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 6 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-blue">
                        💻
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 6
                        </span>

                        <h2>
                            Как сидеть за компьютером?
                        </h2>

                        <p>
                            Несколько простых правил
                            для учёбы и отдыха за экраном.
                        </p>

                        <a
                            href="/lessons/6"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 7 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-purple">
                        🎒
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 7
                        </span>

                        <h2>
                            Как носить рюкзак?
                        </h2>

                        <p>
                            Разберём простые правила,
                            которые помогут организовать рюкзак.
                        </p>

                        <a
                            href="/lessons/7"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 8 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-green">
                        😴
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 8
                        </span>

                        <h2>
                            Почему отдых важен?
                        </h2>

                        <p>
                            Узнай, зачем чередовать активность
                            и отдых в течение дня.
                        </p>

                        <a
                            href="/lessons/8"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 9 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-orange">
                        🛑
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 9
                        </span>

                        <h2>
                            Когда нужно остановиться?
                        </h2>

                        <p>
                            Узнай, почему во время активности
                            важно обращать внимание на своё самочувствие.
                        </p>

                        <a
                            href="/lessons/9"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>


                <!-- 10 -->

                <article class="lesson-card">

                    <div class="lesson-image lesson-pink">
                        🌟
                    </div>

                    <div class="lesson-content">

                        <span class="lesson-number">
                            Урок 10
                        </span>

                        <h2>
                            Маленькие привычки каждый день
                        </h2>

                        <p>
                            Соберём простые идеи,
                            которые можно использовать каждый день.
                        </p>

                        <a
                            href="/lessons/10"
                            class="lesson-button"
                        >
                            Открыть →
                        </a>

                    </div>

                </article>

            </section>

        </div>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-inner">

                <strong>
                    Posture Time
                </strong>

                <span>
                    Двигайся. Узнавай. Расти.
                </span>

                <span>
                    ❤️ Забота о себе — это круто!
                </span>

            </div>

        </div>

    </footer>


</body>

</html>