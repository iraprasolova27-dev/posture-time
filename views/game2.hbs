<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Лови правильную осанку — Posture Time</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/characters.css">

    <style>
        body {
            background: linear-gradient(180deg, #eef8ff, #ffffff);
            color: #183b63;
        }

        .game-page {
            padding: 35px 0 60px;
        }

        .game-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .game-header h1 {
            font-size: 38px;
            font-weight: 800;
            color: #183f72;
        }

        .game-header p {
            color: #71879c;
        }

        .game-panel {
            max-width: 800px;
            margin: auto;
            padding: 25px;
            background: white;
            border-radius: 30px;
            box-shadow: 0 15px 40px rgba(61,126,170,.12);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat {
            padding: 14px;
            background: #f3f8ff;
            border-radius: 17px;
            text-align: center;
        }

        .stat span {
            display: block;
            font-size: 12px;
            color: #8497aa;
        }

        .stat strong {
            font-size: 22px;
        }

        .situation {
            padding: 35px 20px;
            text-align: center;
            background: #f7fbff;
            border-radius: 24px;
            margin-bottom: 20px;
        }

        .situation-icon {
            font-size: 75px;
            margin-bottom: 15px;
        }

        .situation h2 {
            font-size: 25px;
            color: #244b76;
        }

        .answers {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 14px;
        }

        .answer {
            border: 2px solid #dfebf7;
            background: white;
            border-radius: 20px;
            padding: 18px;
            font-size: 17px;
            font-weight: 700;
            color: #315b85;
            cursor: pointer;
        }

        .answer:hover {
            border-color: #8bc9b0;
            transform: translateY(-2px);
        }

        .answer.correct {
            background: #e2f8ed;
            border-color: #51c995;
        }

        .answer.wrong {
            background: #fff0f0;
            border-color: #ef9292;
        }

        .controls {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
        }

        .button {
            border: 0;
            padding: 12px 20px;
            border-radius: 15px;
            font-weight: 700;
            cursor: pointer;
            background: #27c995;
            color: white;
        }

        .button.secondary {
            background: #e4f1ff;
            color: #2864a5;
        }

        .message {
            text-align: center;
            margin-top: 15px;
            min-height: 25px;
            font-weight: 700;
            color: #617b92;
        }

        @media(max-width:600px) {
            .answers {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

{{> header}}

<main>

<div class="container game-page">

    <div class="game-header">
        <h1>🧍 Лови правильную осанку</h1>
        <p>Смотри на ситуацию и быстро выбирай правильный вариант.</p>
    </div>

    <div class="game-panel">

        <div class="stats">

            <div class="stat">
                <span>Очки</span>
                <strong id="score">0</strong>
            </div>

            <div class="stat">
                <span>Серия</span>
                <strong id="combo">0</strong>
            </div>

            <div class="stat">
                <span>Вопрос</span>
                <strong id="question">1</strong>
            </div>

        </div>

        <div class="situation">

            <div class="situation-icon" id="icon">
                💻
            </div>

            <h2 id="title">
                Как лучше сидеть за компьютером?
            </h2>

        </div>

        <div class="answers" id="answers"></div>

        <div class="message" id="message">
            Выбирай ответ!
        </div>

        <div class="controls">

            <button class="button" id="start">
                ▶ Начать игру
            </button>

            <button class="button secondary" id="restart">
                🔄 Заново
            </button>

        </div>

    </div>

</div>

</main>

<script src="/js/character.js"></script>

<script>
const situations = [
    {
        icon: "💻",
        title: "Как лучше сидеть за компьютером?",
        answers: [
            ["Спина опирается на спинку стула", true],
            ["Лечь на стол", false],
            ["Сидеть боком", false],
            ["Сильно наклониться к экрану", false]
        ]
    },
    {
        icon: "🎒",
        title: "Как лучше носить рюкзак?",
        answers: [
            ["На двух лямках", true],
            ["На одном плече", false],
            ["В одной руке", false],
            ["Очень низко", false]
        ]
    },
    {
        icon: "📱",
        title: "Что лучше делать после долгого сидения?",
        answers: [
            ["Встать и немного подвигаться", true],
            ["Сесть ещё удобнее и продолжить", false],
            ["Лечь на телефон", false],
            ["Сидеть неподвижно", false]
        ]
    },
    {
        icon: "📚",
        title: "Как лучше держать книгу?",
        answers: [
            ["Так, чтобы не приходилось сильно наклоняться", true],
            ["Почти на коленях", false],
            ["Очень низко", false],
            ["За спиной", false]
        ]
    },
    {
        icon: "🪑",
        title: "Что помогает сидеть удобнее?",
        answers: [
            ["Стопы стоят устойчиво", true],
            ["Ноги постоянно висят", false],
            ["Сидеть на краю стула", false],
            ["Поджимать ноги под себя", false]
        ]
    }
];

let current = 0;
let score = 0;
let combo = 0;
let playing = false;

const icon = document.getElementById("icon");
const title = document.getElementById("title");
const answers = document.getElementById("answers");
const message = document.getElementById("message");

function shuffle(array) {
    return [...array].sort(() => Math.random() - .5);
}

function showQuestion() {

    const item = situations[current % situations.length];

    icon.textContent = item.icon;
    title.textContent = item.title;

    answers.innerHTML = "";

    shuffle(item.answers).forEach(([text, correct]) => {

        const button = document.createElement("button");

        button.className = "answer";
        button.textContent = text;

        button.addEventListener("click", () => {

            if (!playing) return;

            document
                .querySelectorAll(".answer")
                .forEach(btn => btn.disabled = true);

            if (correct) {

                button.classList.add("correct");

                combo++;
                score += 10 + combo * 2;

                message.textContent =
                    "Правильно! ⭐ Серия продолжается!";

            } else {

                button.classList.add("wrong");

                combo = 0;

                message.textContent =
                    "Почти! Попробуй запомнить правильный вариант.";
            }

            updateStats();

            setTimeout(() => {

                current++;

                if (current >= 10) {
                    finishGame();
                } else {
                    showQuestion();
                }

            }, 700);
        });

        answers.appendChild(button);
    });

    document.getElementById("question").textContent =
        current + 1;
}

function updateStats() {
    document.getElementById("score").textContent = score;
    document.getElementById("combo").textContent = combo;
}

function startGame() {

    current = 0;
    score = 0;
    combo = 0;
    playing = true;

    updateStats();
    showQuestion();

    message.textContent = "Поехали! 🧠";
}

function finishGame() {

    if (window.PostureTime) {
        window.PostureTime.saveGame(2, score).catch(function () {});
    }

    playing = false;

    message.textContent =
        "Раунд завершён! Ты набрала " + score + " очков ⭐";

    localStorage.setItem(
        "postureTimePlayedGame",
        "true"
    );
}

document.getElementById("start").addEventListener("click", startGame);

document.getElementById("restart").addEventListener("click", startGame);

showQuestion();
</script>
<script src="/js/character.js"></script>
<script src="/js/game-music.js"></script>
</body>
</html>