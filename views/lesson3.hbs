<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/characters.css">

{{> header}}


<div class="lesson-page">

    <a href="/lessons" class="back-link">
        ← Назад к урокам
    </a>


    <section class="lesson-header">

        <div class="lesson-number">
            УРОК 3
        </div>

        <h1>Что такое осанка?</h1>

        <p class="lesson-intro">
            Осанка — это привычное положение тела,
            когда человек стоит, сидит или двигается.
        </p>

    </section>


    <section class="lesson-main">

        <div class="lesson-illustration">

            <div class="spine-placeholder">
                🧍
            </div>

            <div class="illustration-character">
                🦊
            </div>

        </div>


        <div class="lesson-text">

            <div class="text-icon">
                🌟
            </div>

            <h2>Почему осанка важна?</h2>

            <p>
                Осанка связана с тем, как мы держим своё тело
                во время сидения, стояния и движения.
            </p>

            <p>
                На положение тела могут влиять наши привычки,
                например то, как мы сидим за столом или
                проводим время за компьютером.
            </p>

            <p>
                Полезно время от времени менять положение тела,
                делать небольшие активные перерывы и больше двигаться.
            </p>

        </div>

    </section>


    <section class="remember-card">

        <div class="remember-icon">
            💡
        </div>

        <div>

            <h2>Запомни</h2>

            <p>
                Осанка — это привычное положение тела.
                На неё могут влиять наши ежедневные привычки
                и образ жизни.
            </p>

        </div>

    </section>


    <section class="lesson-quiz">

        <div class="quiz-label">
            🧠 ПРОВЕРИ СЕБЯ
        </div>

        <h2>
            Что такое осанка?
        </h2>

        <p class="quiz-description">
            Выбери правильный вариант.
        </p>


        <div class="quiz-options">

            <button
                class="quiz-option"
                onclick="checkAnswer(this, false)">
                Только положение головы
            </button>

            <button
                class="quiz-option"
                onclick="checkAnswer(this, true)">
                Привычное положение тела
            </button>

            <button
                class="quiz-option"
                onclick="checkAnswer(this, false)">
                Только положение ног
            </button>

        </div>


        <div id="quiz-result" class="quiz-result"></div>

    </section>


    <div class="lesson-navigation">

        <a href="/lessons/2" class="lesson-button secondary">
            ← Предыдущий
        </a>

        <a href="/lessons/4" class="lesson-button">
            Следующий урок →
        </a>

    </div>

</div>


<script>

    function checkAnswer(button, correct) {

        const result = document.getElementById('quiz-result');

        const buttons = document.querySelectorAll('.quiz-option');

        buttons.forEach(function(item) {
            item.disabled = true;
        });


        if (correct) {

            button.classList.add('correct');

            result.innerHTML =
                '🎉 Правильно! Отличная работа! ⭐ +10 XP';

            result.classList.add('success');

        } else {

            button.classList.add('wrong');

            result.innerHTML =
                '🙂 Не совсем. Правильный ответ — второй вариант.';

            result.classList.add('error');

            buttons.forEach(function(item) {

                if (item.textContent.includes(
                    'Привычное положение тела'
                )) {
                    item.classList.add('correct');
                }

            });

        }

    }

</script>

<script src="/js/activity.js"></script>
<script>
    (function () {
        let savedThisPage = false;

        document.addEventListener('click', function (event) {
            const button = event.target.closest('.quiz-option');
            if (!button || savedThisPage) return;

            setTimeout(async function () {
                if (!button.classList.contains('correct')) return;
                if (!window.PostureTime) return;

                savedThisPage = true;

                try {
                    await window.PostureTime.saveLesson(3);
                } catch (error) {
                    savedThisPage = false;
                    console.log('Урок не сохранён:', error.message);
                }
            }, 0);
        });
    })();
</script>

</body>
</html>
